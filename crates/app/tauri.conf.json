{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fluestr",
  "version": "0.1.0",
  "identifier": "io.github.willihelm.fluestr",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../../ui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../../ui"
    },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fluestr",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "externalBin": ["binaries/whisper-worker"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEOTU0QkZGMzQ4Nzc2NTEKUldSUmRvYzAvMHVWTGUrakJaK0g2L2U4dkl1ZU5sMDlNVllrcHc0QU0yWUNDNlZHWGdCM2NJeVcK",
      "endpoints": [
        "https://github.com/willihelm/fluestr/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
